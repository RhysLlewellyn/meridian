# Postgres. Neon in production, a local container for the test suite.
# The concurrency test reads this too, so it must point at a real Postgres --
# the whole point of that test is that it is not a mock.
DATABASE_URL=postgres://meridian:meridian@localhost:5433/meridian

# Confirmation email. Not needed for the engine or the tests -- with no key the
# send is skipped, the booking still stands, and the confirmation page says the
# email did not go.
RESEND_API_KEY=
# The one address this demo is allowed to email. The booking form is public, so
# a confirmation is delivered only when the booker types this address; every
# other booking has the composed email rendered on the confirmation page
# instead. Unset means nothing is allowlisted, which is the safe way round.
DEMO_EMAIL_RECIPIENT=
